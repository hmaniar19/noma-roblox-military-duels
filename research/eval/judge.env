# Command that reads a prompt on stdin and prints the model's answer on stdout.
# Rule: the judge must be a different model family than the builder (no self-grading),
# and HOLDOUT_CMD a third family (or blank). Set this before research/lock.sh for each phase.
#   Builder Claude (omp default)      -> judge Grok, holdout Codex  (current)
#   Builder Grok (omp --model grok-4.7) -> JUDGE_CMD="claude -p", holdout Codex
# --permission-mode plan keeps the Grok judge read-only.
JUDGE_CMD='grok --no-auto-update -m grok-4.7 --permission-mode plan -p "$(cat)"'
HOLDOUT_CMD="codex exec -"
